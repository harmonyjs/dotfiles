# Shell Aliases Configuration
# Author: harmonyjs
# Repository: https://github.com/harmonyjs/dotfiles

# Basic syntax:
# alias name='command'

# Quotes handling:
# - Use single quotes for literal strings:
#   alias ll='ls -la'
#   alias grep='grep --color=auto'
# - Use double quotes when you need variables or command substitution:
#   alias ghome="cd $HOME/github"
#   alias glog="git log --author=$(git config user.name)"

# Special characters:
# - For commands with pipes:
#   alias dfiles='ls -la | grep "^d"'
#   alias bigfiles='du -sh * | sort -hr | head -5'
# - For multiple commands:
#   alias gac='git add . && git commit -m'
#   alias update='git fetch && git pull'

# After editing this file, reload aliases with:
# source ~/.zsh_aliases
# or
# . ~/.zsh_aliases

# ═══════════════════════════════════════════════════════════════════
# Essential Aliases
# ═══════════════════════════════════════════════════════════════════

alias reload='source ~/.zshrc'

# Open Visual Studio Code Insiders in a new window
alias ci='code-insiders -n .'

# ───────────────────────────────────────────────────────────────────
# Fast Remove (fastrm)
# ───────────────────────────────────────────────────────────────────
# Быстрое удаление директорий через переименование + фоновый rm
#
# Проблема:
#   rm -rf large_directory — блокирует терминал на время удаления
#
# Решение:
#   1. mv мгновенно переименовывает в скрытую .trash_<random>
#   2. rm -rf запускается в фоне (&), терминал сразу свободен
#   3. Скрытое имя не мешает создать новую директорию с тем же именем
#
# Использование:
#   fastrm node_modules    # мгновенно освобождает имя, удаляет в фоне
#   fastrm target          # то же для любой директории
# ───────────────────────────────────────────────────────────────────
fastrm() {
  local target="$1"
  [[ -z "$target" ]] && echo "Usage: fastrm <directory>" && return 1
  [[ ! -e "$target" ]] && echo "fastrm: '$target' not found" && return 1

  # Генерируем уникальное скрытое имя: .trash_<random>
  # $RANDOM даёт число 0-32767, два подряд — достаточно для уникальности
  local trash=".trash_${RANDOM}${RANDOM}"

  # mv — мгновенная операция (просто переименование в той же FS)
  # rm -rf & — удаление в фоне, терминал сразу свободен
  mv "$target" "$trash" && rm -rf "$trash" &
}

