{
  "description": "Impeccable design detector: runs after Edit/Write/apply_patch on UI files and surfaces findings as system reminders.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/hooks/zsh-bashism-guard.py\" ] || python3 \"$HOME/.claude/hooks/zsh-bashism-guard.py\""
          },
          {
            "type": "command",
            "command": "[ ! -f \"$HOME/.claude/hooks/gh-dashdash-guard.py\" ] || python3 \"$HOME/.claude/hooks/gh-dashdash-guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"/Users/andreyvavilov/.agents/skills/impeccable/scripts/hook.mjs\" ] || node \"/Users/andreyvavilov/.agents/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"/Users/andreyvavilov/.agents/skills/impeccable/scripts/hook.mjs\" ] || node \"/Users/andreyvavilov/.agents/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
