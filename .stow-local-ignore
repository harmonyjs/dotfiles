# Directories
\.git
\.github
\.idea
docs
scripts
projects

# Files
\.gitignore
\.gitattributes
\.gitmodules
README\.md
LICENSE
AGENTS\.md
# leading-slash anchors to package root: ignore repo-root CLAUDE.md only,
# so nested .claude/CLAUDE.md (the global Finch instructions) DOES get stowed into ~/.claude/
^/CLAUDE\.md$
Brewfile
Justfile

# macOS Finder junk — regenerates in any directory. A present .stow-local-ignore
# REPLACES Stow's built-in default ignore list, so .DS_Store must be listed
# explicitly or stow tries to symlink every one it finds and aborts on conflict.
\.DS_Store

# Local configuration files
.*\.local\.json
\.zshrc\.local

# Private submodule (stowed separately)
\.private
